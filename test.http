// Listar todos os recursos
GET http://localhost:8787/userByEmail/teste@gmail.com

###

// Criar novo recurso - deve retornar erro (name vazio, password curto)
POST http://localhost:8787/user
Content-Type: application/json

{
  "name": "13",
  "password": "123123",
  "email": "john@example.com",
  "age": 253
}

###

// Criar novo recurso - deve retornar sucesso
POST http://localhost:8787/user
Content-Type: application/json

{
  "name": "John Doe",
  "password": "123456",
  "email": "john@example.com",
  "age": 25
}

###

// Atualizar recurso existente
PUT http://localhost:8787/users/1
Content-Type: application/json

{
  "name": "John Updated",
  "email": "john.updated@example.com"
}

###

// Deletar recurso
DELETE http://localhost:8787/users/1

###

// Login e obter token JWT
POST http://localhost:8787/login
Content-Type: application/json

{
  "username": "johndoe",
  "password": "123456"
}

###

// Acessar rota protegida com token JWT
GET http://localhost:8787/users
Authorization: Bearer <cole_seu_token_aqui>